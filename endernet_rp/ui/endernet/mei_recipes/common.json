{
    "namespace": "EnderNetMeiCommon",
    "background": {
        "type": "image",
        "layer": 1,
        "texture": "textures/ui/mei/recipe/recipe_bg",
        "nineslice_size": [3, 3, 3, 3]
    },
    "progress_arrow": {
        "type": "panel",
        "size": [24, 17],
        "layer": 1,
        "controls": [
            {
                "bg": {
                    "type": "image",
                    "layer": 1,
                    "texture": "textures/ui/arrow_inactive"
                }
            },
            {
                "mask": {
                    "type": "image",
                    "layer": 2,
                    "clip_direction": "left",
                    "texture": "textures/ui/arrow_active"
                }
            }
        ]
    },
    "burn_flame": {
        "type": "panel",
        "size": [15, 15],
        "layer": 1,
        "controls": [
            {
                "bg": {
                    "type": "image",
                    "layer": 1,
                    "texture": "textures/ui/flame_empty_image"
                }
            },
            {
                "mask": {
                    "type": "image",
                    "layer": 2,
                    "clip_direction": "down",
                    "texture": "textures/ui/flame_full_image"
                }
            }
        ]
    },
    "info_hover@mei_common.slot_base": {
        "$binding_name_prefix|default": "mei_ui.recipe.power",
        "size": ["100%", "100%"],
        "controls": [
            {
                "overlay@mei_common.slot_overlay": {
                    "$overlay_btn_control": "mei_common.slot_overlay_button_flat"
                }
            }
        ]
    }
}
