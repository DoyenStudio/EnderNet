{
    "PREVIEW@mei_recipe_common.preview": {
        "$recipe_content_template": "EnderNetMei.content_panel"
    },
    "RECIPES_GRID@mei_recipe_common.recipes_grid": {
        "$recipe_ui_template": "EnderNetMei.recipe"
    },
    "content_panel": {
        "type": "panel",
        "$content_size|default": [
            154,
            62
        ],
        "$output_offset|default": [
            130,
            23
        ],
        "$progress_offset|default": [
            94,
            25
        ],
        "size": "$content_size",
        "layer": 1,
        "controls": [
            {
                "background@EnderNetMeiCommon.background": {}
            },
            {
                "power@EnderNetMeiEnergy.energy_meter": {
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "layer": 2,
                    "offset": [
                        4,
                        4
                    ],
                    "size": [
                        12,
                        54
                    ]
                }
            },
            {
                "body": {
                    "type": "panel",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "layer": 2,
                    "controls": [
                        {
                            "input0": {
                                "type": "panel",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": [
                                    22,
                                    24
                                ],
                                "size": [
                                    20,
                                    20
                                ],
                                "layer": 10,
                                "controls": [
                                    {
                                        "0@mei_common.item_panel": {
                                            "$binding_name_prefix": "mei_ui.recipe.input0"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "input1": {
                                "type": "panel",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": [
                                    42.0,
                                    23
                                ],
                                "size": [
                                    20,
                                    20
                                ],
                                "layer": 10,
                                "controls": [
                                    {
                                        "0@mei_common.item_panel": {
                                            "$binding_name_prefix": "mei_ui.recipe.input1"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "input2": {
                                "type": "panel",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": [
                                    62.0,
                                    23
                                ],
                                "size": [
                                    20,
                                    20
                                ],
                                "layer": 10,
                                "controls": [
                                    {
                                        "0@mei_common.item_panel": {
                                            "$binding_name_prefix": "mei_ui.recipe.input2"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "output": {
                                "type": "panel",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": "$output_offset",
                                "size": [
                                    20,
                                    20
                                ],
                                "layer": 10,
                                "controls": [
                                    {
                                        "0@mei_common.item_panel": {
                                            "$binding_name_prefix": "mei_ui.recipe.output0"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "progress@EnderNetMeiCommon.progress_arrow": {
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": "$progress_offset",
                                "size": [
                                    24,
                                    17
                                ]
                            }
                        },
                        {
                            "progress_hover@EnderNetMeiCommon.info_hover": {
                                "$binding_name_prefix": "mei_ui.recipe.progress",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "layer": 9,
                                "offset": "$progress_offset",
                                "size": [
                                    24,
                                    17
                                ]
                            }
                        },
                        {
                            "mode": {
                                "type": "label",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": [
                                    22,
                                    5
                                ],
                                "size": [
                                    "100%-26px",
                                    12
                                ],
                                "layer": 3,
                                "color": [
                                    0.2,
                                    0.2,
                                    0.2
                                ],
                                "font_size": "normal",
                                "text": ""
                            }
                        }
                    ]
                }
            }
        ]
    },
    "namespace": "EnderNetMei",
    "recipe@mei_recipe_common.recipe_panel": {
        "controls": [
            {
                "wrapper": {
                    "type": "panel",
                    "size": [
                        154,
                        62
                    ],
                    "layer": 1,
                    "controls": [
                        {
                            "content@EnderNetMei.content_panel": {}
                        },
                        {
                            "buttons@mei_recipe_common.buttons_panel_vertical": {
                                "$plus_button_ignored": false,
                                "$tree_button_ignored": false
                            }
                        }
                    ]
                }
            }
        ],
        "size": [
            188,
            66
        ]
    }
}