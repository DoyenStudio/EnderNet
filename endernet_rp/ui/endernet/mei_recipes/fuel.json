{
    "namespace": "EnderNetMeiFuel",
    "RECIPES_GRID@mei_recipe_common.recipes_grid": {
        "$recipe_ui_template": "EnderNetMeiFuel.recipe"
    },
    "PREVIEW@mei_recipe_common.preview": {
        "$recipe_content_template": "EnderNetMeiFuel.content_panel"
    },
    "recipe@mei_recipe_common.recipe_panel": {
        "size": [
            188,
            66
        ],
        "controls": [
            {
                "wrapper": {
                    "type": "panel",
                    "size": [
                        85,
                        62
                    ],
                    "layer": 1,
                    "controls": [
                        {
                            "content@EnderNetMeiFuel.content_panel": {}
                        },
                        {
                            "buttons@mei_recipe_common.buttons_panel_vertical": {
                                "$plus_button_ignored": true,
                                "$tree_button_ignored": true
                            }
                        }
                    ]
                }
            }
        ]
    },
    "content_panel": {
        "type": "panel",
        "size": [85, 62],
        "layer": 1,
        "controls": [
            {
                "background@EnderNetMeiCommon.background": {}
            },
            {
                "power@EnderNetMeiEnergy.energy_meter": {
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "layer": 2,
                    "offset": [63, 4],
                    "size": [18, 54]
                }
            },
            {
                "body": {
                    "type": "panel",
                    "size": ["100%", "100%"],
                    "layer": 2,
                    "controls": [
                        {
                            "input": {
                                "type": "panel",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": [4, 23],
                                "size": [20, 20],
                                "layer": 10,
                                "controls": [
                                    {
                                        "0@mei_common.item_panel": {
                                            "$binding_name_prefix": "mei_ui.recipe.input0"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "flame@EnderNetMeiCommon.burn_flame": {
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "offset": [6, 6]
                            }
                        },
                        {
                            "progress_hover@EnderNetMeiCommon.info_hover": {
                                "$binding_name_prefix": "mei_ui.recipe.progress",
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "layer": 9,
                                "offset": [6, 6],
                                "size": [15, 15]
                            }
                        }
                    ]
                }
            }
        ]
    }
}
