{
    "backpack_slot@endernet_windows.item_can_be_selected": {
        "$item_collection_name": "endernet_terminal_backpack",
        "$item_visible_binding": "#EnderNetTerminal.backpack_visible",
        "$item_id_aux_binding": "#EnderNetTerminal.backpack_item_id_aux",
        "$item_selected_binding": "#EnderNetTerminal.backpack_selected",
        "$item_count_binding": "#EnderNetTerminal.backpack_item_count",
        "$item_select_button": "#EnderNetTerminal.backpack_click"
    },
    "hotbar_slot@endernet_windows.item_can_be_selected": {
        "$item_collection_name": "endernet_terminal_hotbar",
        "$item_visible_binding": "#EnderNetTerminal.hotbar_visible",
        "$item_id_aux_binding": "#EnderNetTerminal.hotbar_item_id_aux",
        "$item_selected_binding": "#EnderNetTerminal.hotbar_selected",
        "$item_count_binding": "#EnderNetTerminal.hotbar_item_count",
        "$item_select_button": "#EnderNetTerminal.hotbar_click"
    },
    "inventory": {
        "type": "panel",
        "$display_inventory_label": true,
        "anchor_from": "bottom_middle",
        "anchor_to": "bottom_middle",
        "size": [
            162,
            101
        ],
        "layer": 10,
        "controls": [
            {
                "label": {
                    "type": "label",
                    "$display_inventory_label|default": false,
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "offset": [
                        0,
                        0
                    ],
                    "visible": "$display_inventory_label",
                    "color": [
                        0.31,
                        0.31,
                        0.31
                    ],
                    "text": "container.inventory"
                }
            },
            {
                "backpack": {
                    "type": "grid",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        0,
                        12.0
                    ],
                    "size": [
                        162,
                        54
                    ],
                    "collection_name": "endernet_terminal_backpack",
                    "grid_dimensions": [
                        9,
                        3
                    ],
                    "grid_item_template": "endernet_terminal_inventory.backpack_slot",
                    "maximum_grid_items": 27
                }
            },
            {
                "hotbar": {
                    "type": "grid",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        0,
                        72.0
                    ],
                    "size": [
                        162,
                        18
                    ],
                    "collection_name": "endernet_terminal_hotbar",
                    "grid_dimensions": [
                        9,
                        1
                    ],
                    "grid_item_template": "endernet_terminal_inventory.hotbar_slot",
                    "maximum_grid_items": 9
                }
            },
            {
                "upper_frame": {
                    "type": "image",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        0.0,
                        12.0
                    ],
                    "size": [
                        "default",
                        54.0
                    ],
                    "layer": 10,
                    "texture": "textures/ui/endernet/slots_frame"
                }
            },
            {
                "lower_frame": {
                    "type": "image",
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        0.0,
                        72.0
                    ],
                    "size": [
                        "default",
                        18.0
                    ],
                    "layer": 10,
                    "texture": "textures/ui/endernet/slots_frame"
                }
            }
        ]
    },
    "namespace": "endernet_terminal_inventory"
}