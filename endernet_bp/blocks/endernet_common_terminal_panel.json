{
    "format_version": "1.21.70",
    "minecraft:block": {
        "components": {
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 3.0
            },
            "netease:tier": {
                "destroy_special": true,
                "digger": "pickaxe",
                "level": 2
            },
            "minecraft:geometry": {
                "identifier": "minecraft:geometry.full_block"
            },
            "minecraft:material_instances": {
                "*": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_side"
                },
                "down": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_bottom"
                },
                "east": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_side"
                },
                "north": {
                    "render_method": "opaque",
                    "texture": "endernet:common_terminal_panel_front"
                },
                "south": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_side"
                },
                "up": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_top"
                },
                "west": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_side"
                }
            },
            "netease:block_entity": {
                "tick": false
            },
            "netease:listen_block_remove": {
                "value": true
            },
            "netease:custom_tips": {
                "value": "\n§7管理网络的仓储信息。"
            }
        },
        "description": {
            "category": "endernet",
            "identifier": "endernet:common_terminal_panel",
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180.0
                }
            },
            "states": {
                "endernet:status": [
                    0,
                    1
                ]
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('endernet:status') == 1",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "render_method": "opaque",
                            "texture": "endernet:common_device_side_offline"
                        },
                        "down": {
                            "render_method": "opaque",
                            "texture": "endernet:common_device_bottom_offline"
                        },
                        "east": {
                            "render_method": "opaque",
                            "texture": "endernet:common_device_side_offline"
                        },
                        "north": {
                            "render_method": "opaque",
                            "texture": "endernet:common_terminal_panel_front_offline"
                        },
                        "south": {
                            "render_method": "opaque",
                            "texture": "endernet:common_device_side_offline"
                        },
                        "up": {
                            "render_method": "opaque",
                            "texture": "endernet:common_device_top_offline"
                        },
                        "west": {
                            "render_method": "opaque",
                            "texture": "endernet:common_device_side_offline"
                        }
                    }
                }
            }
        ]
    }
}
