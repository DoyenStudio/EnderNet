{
    "format_version": "1.21.70",
    "minecraft:block": {
        "components": {
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 3.0
            },
            "netease:tier": {
                "destroy_special": true,
                "digger": "pickaxe",
                "level": 2
            },
            "minecraft:geometry": {
                "identifier": "minecraft:geometry.full_block"
            },
            "minecraft:material_instances": {
                "*": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_side"
                },
                "down": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_bottom"
                },
                "east": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_side"
                },
                "north": {
                    "render_method": "opaque",
                    "texture": "endernet:storage_transfer_front"
                },
                "south": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_side"
                },
                "up": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_top"
                },
                "west": {
                    "render_method": "opaque",
                    "texture": "endernet:common_device_side"
                }
            },
            "netease:block_entity": {
                "tick": false
            },
            "netease:listen_block_remove": {
                "value": true
            },
            "netease:block_container": {
                "custom_description": "存储转储器",
                "screen_name": "endernet_storage_transfer.main",
                "container_size": 4
            },
            "netease:custom_tips": {
                "value": "\n§7将四槽非空介质中的内容转存至网络；占用 1u。"
            }
        },
        "description": {
            "category": "endernet",
            "identifier": "endernet:storage_transfer",
            "base_block": "netease_container",
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180.0
                }
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    }
                }
            }
        ]
    }
}
