{
    "format_version": "1.21.70",
    "minecraft:block": {
        "components": {
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 3.0
            },
            "netease:tier": {
                "destroy_special": true,
                "digger": "pickaxe",
                "level": 2
            },
            "minecraft:geometry": {
                "identifier": "geometry.endernet.memory_slot"
            },
            "minecraft:light_dampening": 0,
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    8,
                    16
                ]
            },
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    8,
                    16
                ]
            },
            "minecraft:material_instances": {
                "*": {
                    "render_method": "opaque",
                    "texture": "endernet:memory_slot_model"
                }
            },
            "netease:block_entity": {
                "tick": false
            },
            "netease:listen_block_remove": {
                "value": true
            },
            "netease:block_container": {
                "custom_description": "内存槽",
                "screen_name": "endernet_memory_slot.main",
                "container_size": 10
            },
            "netease:custom_tips": {
                "value": "\n§7插入内存条，为网络提供配方运行内存。"
            }
        },
        "description": {
            "category": "endernet",
            "identifier": "endernet:memory_slot",
            "base_block": "netease_container",
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180.0
                },
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face",
                        "minecraft:vertical_half"
                    ]
                }
            },
            "states": {
                "endernet:status": [
                    0,
                    1
                ]
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('endernet:status') == 0 && !(q.block_state('minecraft:block_face') == 'down' && q.block_state('minecraft:vertical_half') == 'bottom')",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "render_method": "opaque",
                            "texture": "endernet:memory_slot_model_offline"
                        }
                    }
                }
            }
        ]
    }
}
